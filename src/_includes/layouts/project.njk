---
layout: layouts/base.njk
ogType: article
---
<article class="project-page" itemscope itemtype="https://schema.org/CreativeWork">
  <header class="project-hero">
    <div class="project-hero__media">
      <img
        src="{{ image }}"
        alt="{{ imageAlt or title }}"
        width="1600"
        height="1000"
        fetchpriority="high"
      >
    </div>
    <div class="container project-hero__content">
      <p class="eyebrow">{{ category }}</p>
      <h1 itemprop="name">{{ title }}</h1>
      <p class="lede" itemprop="description">{{ summary }}</p>
      {% if role %}<p class="project-role"><strong>My role:</strong> {{ role }}</p>{% endif %}
      {% if metrics and metrics.length %}
      <dl class="metric-strip">
        {% for metric in metrics %}
        <div>
          <dt>{{ metric.label }}</dt>
          <dd>{{ metric.value }}</dd>
        </div>
        {% endfor %}
      </dl>
      {% endif %}
    </div>
  </header>

  <div class="container project-layout">
    <aside class="project-sidebar" aria-label="Project overview">
      {% if problem %}
      <section>
        <h2>Problem</h2>
        <p>{{ problem }}</p>
      </section>
      {% endif %}
      {% if contribution %}
      <section>
        <h2>My Contribution</h2>
        <p>{{ contribution }}</p>
      </section>
      {% endif %}
      {% if constraints and constraints.length %}
      <section>
        <h2>Constraints</h2>
        <ul>
          {% for item in constraints %}
          <li>{{ item }}</li>
          {% endfor %}
        </ul>
      </section>
      {% endif %}
      {% if tools and tools.length %}
      <section>
        <h2>Tools</h2>
        <ul class="tag-list">
          {% for tool in tools %}
          <li>{{ tool }}</li>
          {% endfor %}
        </ul>
      </section>
      {% endif %}
      {% if result %}
      <section>
        <h2>Result</h2>
        <p>{{ result }}</p>
      </section>
      {% endif %}
    </aside>

    <div class="project-body prose" itemprop="text">
      {{ content | safe }}
    </div>
  </div>

  <div class="container project-nav">
    <a class="text-link" href="/projects/">← All projects</a>
    <a class="button button--secondary" href="{{ site.resume.pdf }}">Download resume</a>
  </div>
</article>
