<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__brand">{{ site.name }}</p>
      <p class="site-footer__tag">{{ site.title }} · {{ site.education.degree }}, {{ site.education.school }}</p>
    </div>
    <div class="site-footer__links">
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      <a href="{{ site.linkedin }}" rel="noopener noreferrer" target="_blank">LinkedIn</a>
      <a href="{{ site.resume.pdf }}">Resume PDF</a>
    </div>
    <p class="site-footer__copy">© {% year %} {{ site.name }}</p>
  </div>
</footer>
