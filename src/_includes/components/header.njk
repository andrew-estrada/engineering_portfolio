<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="site-logo" href="/">
      <span class="site-logo__name">{{ site.name }}</span>
      <span class="site-logo__title">{{ site.title }}</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="visually-hidden">Menu</span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="site-nav" data-nav aria-label="Primary">
      <ul>
        {% for item in navigation %}
        <li>
          <a
            href="{{ item.url }}"
            {% if page.url == item.url or (item.url != '/' and page.url | startsWith(item.url)) %}aria-current="page"{% endif %}
          >{{ item.label }}</a>
        </li>
        {% endfor %}
      </ul>
      <a class="button button--small" href="{{ site.resume.pdf }}">Resume PDF</a>
    </nav>
  </div>
</header>
