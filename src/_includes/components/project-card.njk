<article class="project-card">
  <a class="project-card__media" href="{{ project.url }}">
    <img
      src="{{ project.data.image }}"
      alt="{{ project.data.imageAlt or project.data.title }}"
      width="800"
      height="500"
      loading="lazy"
      decoding="async"
    >
  </a>
  <div class="project-card__body">
    <p class="eyebrow">{{ project.data.category }}</p>
    <h3><a href="{{ project.url }}">{{ project.data.title }}</a></h3>
    <p>{{ project.data.summary }}</p>
    {% if project.data.role %}<p class="project-card__role">{{ project.data.role }}</p>{% endif %}
    <a class="text-link" href="{{ project.url }}">View case study</a>
  </div>
</article>
